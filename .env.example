# Copy to .env and fill in your values: cp .env.example .env
# .env is git-ignored, so your token never lands in the repository.

# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token

# Optional: llama.cpp server endpoint (llama-server or llama-swap, OpenAI-compatible)
LLM_URL=http://localhost:8080/v1/chat/completions

# Optional: SQLite file for per-user memory
MEMORY_FILE=user_memory.sqlite
